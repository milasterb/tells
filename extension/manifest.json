{
  "manifest_version": 3,
  "name": "Tells",
  "version": "0.1.0",
  "description": "Every scam has a tell. Tells finds it and explains it in plain language, before you click.",

  "permissions": ["storage"],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "service-worker.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/signals.js", "ui/card.js", "content/gmail-adapter.js"],
      "css": ["ui/card.css", "content/inject.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Tells",
    "default_popup": "popup/popup.html"
  }
}